<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Clinica.master.cs" Inherits="Presentación.Clinica" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sistema Clínica</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />


    <%--<link href="Assets/CSS/Master.css" rel="stylesheet" />--%>
    <link href="<%= ResolveUrl("~/Assets/CSS/Master.css") %>?v=1.0" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>

<body>

    <form id="form2" runat="server">

        <div class="contenedor-principal">

            <%--Menu lateral--%>
            <aside class="menu-lateral">

                <%-- Logo --%>
                <div class="encabezado-menu">
                    <div class="logo-contenedor">
                        <img src="<%= ResolveUrl("~/Assets/IMG/logo-clinica.png") %>"
                            alt="Logo Sistema Clínica"
                            class="logo-imagen" />
                    </div>
                    <div class="logo-texto">
                        <span class="logo-nombre">Sistema Clínica</span>
                        <span class="logo-subtitulo">Gestión integral de la salud
                        </span>
                    </div>

                </div>


                <%-- Navegación --%>
                <ul class="lista-menu">

                    <li id="liSeccionPrincipal" runat="server"><span class="menu-seccion">General</span></li>

                    <li id="liInicio" runat="server">
                        <a href="~/Default.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            <span>Inicio</span>
                        </a>
                    </li>

                    <li id="liSeccionGestion" runat="server"><span class="menu-seccion">Gestión</span></li>

                    <li id="liMedicos" runat="server">
                        <a href="~/Medicos.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-heart-pulse" aria-hidden="true"></i>
                            <span>Médicos</span>
                        </a>
                    </li>
                    <li id="liPacientes" runat="server">
                        <a href="~/Pacientes.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-people" aria-hidden="true"></i>
                            <span>Pacientes</span>
                        </a>
                    </li>
                    <li id="liTurnos" runat="server">
                        <a href="~/Turnos.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-calendar-check" aria-hidden="true"></i>
                            <span>Turnos</span>
                        </a>
                    </li>

                    <li id="liSeccionAtencion" runat="server"><span class="menu-seccion">Atención</span></li>

                    <li id="liMiAgenda" runat="server">
                        <a href="~/MiAgenda.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-calendar-check" aria-hidden="true"></i>
                            <span>Mi Agenda</span>
                        </a>
                    </li>
                    <li id="liMiDisponibilidad" runat="server">
                        <a href="~/MiDisponibilidad.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-calendar-check" aria-hidden="true"></i>
                            <span>Mi Disponibilidad</span>
                        </a>
                    </li>
                    <li id="liHistoriaClinica" runat="server">
                        <a href="~/HistorialClinico.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-file-text" aria-hidden="true"></i>
                            <span>Historias Clínicas</span>
                        </a>
                    </li>

                    <li id="liSeccionAdministracion" runat="server"><span class="menu-seccion">Administración</span></li>

                    <li id="liUsuarios" runat="server">
                        <a href="~/Usuarios.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-person-badge" aria-hidden="true"></i>
                            <span>Usuarios</span>
                        </a>
                    </li>
                    <li id="liConfiguracion" runat="server">
                        <a href="~/Configuracion.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-gear" aria-hidden="true"></i>
                            <span>Configuraciones</span>
                        </a>
                    </li>
                    
                    <li id="liSeccionCuenta" runat="server"><span class="menu-seccion">Cuenta</span></li>
                    <li id="liMiPerfil" runat="server">
                        <a href="~/MiPerfil.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-gear" aria-hidden="true"></i>
                            <span>Mi Perfil</span>
                        </a>
                    </li>

                </ul>

                <div class="menu-salir">
                    <asp:LinkButton
                        ID="btnCerrarSesion"
                        runat="server"
                        CssClass="opcion-salir"
                        OnClick="btnCerrarSesion_Click">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        <span>Cerrar sesión</span>
                    </asp:LinkButton>
                </div>

            </aside>

            <div class="contenido-principal">

                <%-- Barra superior --%>
                <header class="barra-superior">

                    <div class="titulo-pagina">
                        <asp:Label ID="lblTituloPagina" runat="server" />
                    </div>

                    <div class="usuario-sistema">
                        <div>
                            <asp:Label ID="lblNombreUsuario" runat="server" />
                            <asp:Label ID="lblRolUsuario" runat="server" CssClass="text-muted" />
                        </div>
                        <asp:Image ID="imgUsuario" runat="server" CssClass="avatar-usuario" AlternateText="Avatar" />
                    </div>

                </header>

                <main class="contenido">
                    <asp:ContentPlaceHolder ID="contenido" runat="server" />
                </main>

                <footer class="footer">
                    Sistema Clínica &mdash; 2026
               
                </footer>

            </div>

        </div>

    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
