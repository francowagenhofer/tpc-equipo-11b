<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Clinica.master.cs" Inherits="Presentación.Clinica" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Sistema Clínica</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="Assets/CSS/Master.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>

<body>

    <form id="form2" runat="server">

        <div class="contenedor-principal">

            <!-- MENU LATERAL -->
            <aside class="menu-lateral">

                <div class="encabezado-menu">
                    <h4 class="titulo-menu">Clínica</h4>
                    <small class="subtitulo-menu">Sistema de gestión</small>
                </div>

                <ul class="lista-menu">

                    <li>
                        <a href="~/Default.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-speedometer2"></i>
                            <span>Inicio</span>
                        </a>
                    </li>

                    <li>
                        <a href="~/Especialidades.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-journal-medical"></i>
                            <span>Especialidades</span>
                        </a>
                    </li>
                    <li>
                        <a href="~/Medicos.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-heart-pulse"></i>
                            <span>Médicos</span>
                        </a>
                    </li>
                    <li>
                        <a href="~/Pacientes.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-people"></i>
                            <span>Pacientes</span>
                        </a>
                    </li>
                    <li>
                        <a href="~/Turnos.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-calendar-check"></i>
                            <span>Turnos</span>
                        </a>
                    </li>
                    <li>
                        <a href="~/Usuarios.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-journal-medical"></i>
                            <span>Usuarios</span>
                        </a>
                    </li>
                    <li>
                        <a href="~/Configuracion.aspx" runat="server" class="opcion-menu">
                            <i class="bi bi-gear"></i>
                            <span>Configuraciones</span>
                        </a>
                    </li>

                </ul>

                <div class="menu-salir">
                    <asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="opcion-salir" OnClick="btnCerrarSesion_Click">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Cerrar sesión</span>
                    </asp:LinkButton>
                </div>

            </aside>

            <!-- CONTENIDO PRINCIPAL -->
            <div class="contenido-principal">

                <!-- BARRA SUPERIOR -->
                <header class="barra-superior">

                    <div class="titulo-pagina">
                        <asp:Label ID="lblTituloPagina" runat="server" />
                    </div>

                    <div class="usuario-sistema">
                        <asp:Image ID="imgUsuario" runat="server" CssClass="avatar-usuario" />

                        <div>
                            <asp:Label ID="lblNombreUsuario" runat="server" />
                            <br />
                            <asp:Label ID="lblRolUsuario" runat="server" CssClass="text-muted" />
                        </div>
                    </div>

                </header>

                <!-- CONTENIDO DINAMICO -->
                <main class="contenido">
                    <asp:ContentPlaceHolder ID="contenido" runat="server" />
                </main>

                <footer class="footer">
                    Sistema Clínica - 2026
                </footer>

            </div>

        </div>

    </form>

</body>

</html>
